<LoginScreen>:
    FloatLayout:
        # Central BoxLayout for form elements
        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.8, None
            height: self.minimum_height
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            Label:
                text: 'Login Screen'
                font_size: '24sp'
                size_hint_y: None
                height: '40dp'

            TextInput:
                id: username
                hint_text: 'Username'
                multiline: False
                size_hint_y: None
                height: '50dp'

            TextInput:
                id: password
                hint_text: 'Password'
                password: True
                multiline: False
                size_hint_y: None
                height: '50dp'

            Button:
                text: 'Login'
                size_hint_y: None
                height: '50dp'
                on_release: root.validate_login()

            Label:
                id: login_message
                color: (1, 0, 0, 1)
                size_hint_y: None
                height: '30dp'

            Button:
                text: 'Register'
                size_hint_y: None
                height: '50dp'
                on_release: app.root.current = 'register'

            Button:
                text: 'Change Password'
                size_hint_y: None
                height: '50dp'
                on_release: app.root.current = 'change_password'