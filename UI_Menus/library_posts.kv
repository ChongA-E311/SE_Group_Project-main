<LibraryPostsScreen@BaseScreen>:
    FloatLayout:
        ScrollView:
            size_hint: 0.9, 0.7
            pos_hint: {'center_x': 0.5, 'top': 0.85}
            BoxLayout:
                id: posts_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height